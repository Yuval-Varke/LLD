# pyenv
#   For a library or package, you might want to comit it.
#   For an application or deploying to a server, you likely want to ignore it.
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case you're running an application rather than a library, you might need to ignore it.
#Pipfile.lock

# poetry
#   Poetry uses poetry.lock to ensure reproducible builds. It's recommended to commit it.
#poetry.lock

# pdm
#   PDM stores project-wide configurations in .pdm.toml
.pdm.toml
.pdm-plugins/
.pdm-build/

# PEP 582 spaces
__pypackages__/

